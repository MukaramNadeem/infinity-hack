# Database (SQLite file, path relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# AI (OpenRouter, OpenAI-compatible API)
# AI_MOCK="true" uses the offline mock (no key needed; understands the sample meeting's
# "Final recap" format only). Set AI_MOCK="false" and a key to use the real model.
OPENROUTER_API_KEY=""
AI_MODEL="openai/gpt-4o-mini"
AI_MOCK="true"

# Server
PORT=4000
# Listen address (0.0.0.0 = reachable as localhost and 127.0.0.1, also from Windows when running in WSL)
HOST="0.0.0.0"
# Frontend origin(s) allowed by CORS (comma-separated for several)
FRONTEND_URL="http://localhost:5173"
